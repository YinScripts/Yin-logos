                { Image = "rbxassetid://TU_ID_2", Movement = "Pulse", Speed = 1.2, Amount = 12 },
                { Image = "rbxassetid://TU_ID_3", Movement = "Orbit", Speed = 40, Amount = 6, Direction = -1 },
